# Host-side settings read by the Tukevejtso launcher. The managed service always
# listens on 0.0.0.0:8084 inside its environment.
PORT=8084

# Use 127.0.0.1 to make the service local-only, or 0.0.0.0 for LAN access.
BIND_ADDRESS=0.0.0.0

# Per-file inbound upload limit, in megabytes.
MAX_FILE_SIZE_MB=1024
